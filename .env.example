# ---------------------------------------------------------------------------
# App env (validated in src/config/env.ts, safe defaults for local dev)
# ---------------------------------------------------------------------------
VITE_APP_NAME=Vite React TS Starter
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_API_TIMEOUT_MS=10000
VITE_ENABLE_AXE=false

# ---------------------------------------------------------------------------
# Docker / CI (used by the Makefile, docker-compose.yml, and .gitlab-ci.yml)
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=example-project
APP_NAME=example-project
APP_VERSION=1.0.0
HUB_URL=registry.example.com
APP_PORT=8080
